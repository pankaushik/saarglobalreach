;(function ($) {

    "use strict";

    $(document).ready(function () {
        $('.pxl-date-time input').datetimepicker({
            timepicker: true,
            format:'H:i - F j, Y'
        }); 
        $('.pxl-date input').datetimepicker({
            timepicker: false,
            format:'F j, Y'
        }); 
        
        $('.pxl-time input').datetimepicker({
            datepicker: false,
            format:'H:i'
        }); 
    });

})(jQuery);